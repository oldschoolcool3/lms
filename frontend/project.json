{
  "name": "frontend",
  "projectType": "application",
  "targets": {
    "serve": {
      "command": "yarn dev",
      "options": { "cwd": "frontend" }
    },
    "build": {
      "command": "yarn build",
      "options": { "cwd": "frontend" },
      "cache": true,
      "inputs": [
        "production",
        "{projectRoot}/index.html",
        "{projectRoot}/vite.config.js",
        "{projectRoot}/tailwind.config.js",
        "{projectRoot}/postcss.config.js",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.node.json"
      ],
      "outputs": [
        "{workspaceRoot}/lms/public/frontend",
        "{workspaceRoot}/lms/www/_lms.html"
      ]
    },
    "test": {
      "command": "yarn test",
      "options": { "cwd": "frontend" },
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/vitest.config.ts"
      ]
    },
    "lint": {
      "command": "yarn lint",
      "options": { "cwd": "frontend" },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/eslint.config.js",
        "{projectRoot}/eslint-suppressions.json",
        "{projectRoot}/.prettierrc.json",
        "{projectRoot}/.prettierignore",
        "{projectRoot}/package.json",
        "{projectRoot}/yarn.lock",
        "{workspaceRoot}/.editorconfig"
      ]
    },
    "typecheck": {
      "command": "yarn typecheck",
      "options": { "cwd": "frontend" },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.node.json",
        "{projectRoot}/typecheck-baseline.json",
        "{projectRoot}/package.json",
        "{projectRoot}/yarn.lock",
        "{workspaceRoot}/scripts/frontend-typecheck.mjs"
      ]
    }
  }
}
